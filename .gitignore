# Ignore environment variables / secrets

# ======================================
# 🔒 SECURITY & SECRETS (MOST IMPORTANT)
# ======================================
.env
*.env
.env.*
sample-agent/.env
kaggle_secrets/
secrets.yaml

# ======================================
# 🐍 PYTHON CACHE & VIRTUAL ENV
# ======================================
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
venv/
.venv/
ENV/
env/
pip-log.txt
pip-delete-this-directory.txt

# ======================================
# 📓 JUPYTER / IPYTHON
# ======================================
.ipynb_checkpoints/
*.ipynb_checkpoints
*/.ipynb_checkpoints/
.mypy_cache/
.dmypy.json
dmypy.json

# ======================================
# 🗄️ DATABASES & LOGS
# ======================================
*.db
*.sqlite
*.sqlite3
*.log
logs/

# ======================================
# 🖥️ OS SPECIFIC
# ======================================
.DS_Store
Thumbs.db
desktop.ini

# ======================================
# 🧪 KAGGLE / ADK GENERATED FOLDERS
# ======================================
# The 'sample-agent' folder is generated by the 'adk create' command.
# Modified the agent inside it, KEEP the folder but IGNORE its .env.
# Recommend keeping the folder in git, but if it's auto-generated,  ignore it.
# Uncomment the line below if you DON'T want to commit the generated agent folder.

sample-agent/.env
# sample-agent